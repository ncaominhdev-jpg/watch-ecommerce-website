{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "next.config.Js", "src/components/ecommerce/DemographicCard.jsx", "src/components/ecommerce/EcommerceMetrics.jsx", "src/components/ecommerce/MonthlySalesChart.jsx", "src/components/ecommerce/MonthlyTarget.jsx", "src/components/ecommerce/RecentOrders.jsx", "src/components/ecommerce/StatisticsChart.jsx", "src/components/common/ChartTab.jsx", "src/components/common/ComponentCard.jsx", "src/components/common/GridShape.jsx", "src/components/common/PageBreadCrumb.jsx", "src/components/common/ThemeToggleButton.jsx", "src/components/common/ThemeTogglerTwo.jsx", "src/app/admin/page.jsx", "src/styles/admin/js/app.min.js"],
  "exclude": ["node_modules"]
}
